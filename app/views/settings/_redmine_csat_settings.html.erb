<p><%= label_tag 'settings_enabled', l(:field_csat_enabled) %><%= hidden_field_tag 'settings[enabled]', '0' %><%= check_box_tag 'settings[enabled]', '1', @settings['enabled'] == '1' %></p>
<p><%= label_tag 'settings_customer_role_id', l(:field_csat_customer_role) %><%= select_tag 'settings[customer_role_id]', options_for_select([[l(:label_none),'']] + Role.sorted.map{|r|[r.name,r.id]}, @settings['customer_role_id']) %></p>
<p><%= label_tag 'settings_owner_email_custom_field_id', l(:field_csat_owner_email_field) %><%= select_tag 'settings[owner_email_custom_field_id]', options_for_select([[l(:label_none),'']] + IssueCustomField.sorted.map{|f|[f.name,f.id]}, @settings['owner_email_custom_field_id']) %></p>
<p><%= label_tag 'settings_trigger_status_ids', l(:field_csat_trigger_statuses) %><%= select_tag 'settings[trigger_status_ids][]', options_from_collection_for_select(IssueStatus.sorted,:id,:name,Array(@settings['trigger_status_ids']).map(&:to_i)), multiple:true, size:6 %></p>
<p><%= label_tag 'settings_cooldown_days', l(:field_csat_cooldown_days) %><%= number_field_tag 'settings[cooldown_days]', @settings['cooldown_days'], min:0 %></p>
<p><%= label_tag 'settings_minimum_issue_age_hours', l(:field_csat_minimum_issue_age_hours) %><%= number_field_tag 'settings[minimum_issue_age_hours]', @settings['minimum_issue_age_hours'], min:0 %></p>
<p><%= label_tag 'settings_rating_prompt', l(:field_csat_rating_prompt) %><%= text_field_tag 'settings[rating_prompt]', @settings['rating_prompt'], size:70 %></p>
<p><%= label_tag 'settings_mail_subject', l(:field_csat_mail_subject) %><%= text_field_tag 'settings[mail_subject]', @settings['mail_subject'], size:70 %><em class="info">%{issue_id}, %{issue_subject}, %{project}</em></p>
<p><%= label_tag 'settings_allow_comment', l(:field_csat_allow_comment) %><%= hidden_field_tag 'settings[allow_comment]', '0' %><%= check_box_tag 'settings[allow_comment]', '1', @settings['allow_comment']=='1' %></p>
<p><%= label_tag 'settings_create_follow_up_on_poor', l(:field_csat_create_follow_up) %><%= hidden_field_tag 'settings[create_follow_up_on_poor]', '0' %><%= check_box_tag 'settings[create_follow_up_on_poor]', '1', @settings['create_follow_up_on_poor']=='1' %></p>
<p><%= label_tag 'settings_follow_up_tracker_id', l(:field_csat_follow_up_tracker) %><%= select_tag 'settings[follow_up_tracker_id]', options_for_select([[l(:label_none),'']] + Tracker.sorted.map{|t|[t.name,t.id]}, @settings['follow_up_tracker_id']) %></p>
<p><%= label_tag 'settings_follow_up_assignee_id', l(:field_csat_follow_up_assignee) %><%= select_tag 'settings[follow_up_assignee_id]', options_for_select([[l(:label_none),'']] + User.active.sorted.limit(500).map{|u|[u.name,u.id]}, @settings['follow_up_assignee_id']) %></p>
